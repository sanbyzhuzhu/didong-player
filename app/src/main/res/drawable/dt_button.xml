<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dt_panel_pressed" />
            <stroke android:width="1dp" android:color="@color/dt_accent" />
            <corners android:radius="10dp" />
            <padding android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dt_panel" />
            <stroke android:width="1dp" android:color="@color/dt_stroke" />
            <corners android:radius="10dp" />
            <padding android:left="6dp" android:top="4dp" android:right="6dp" android:bottom="4dp" />
        </shape>
    </item>
</selector>
