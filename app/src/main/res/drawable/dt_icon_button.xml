<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dt_glow">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/dt_pressed" />
                    <stroke android:width="1dp" android:color="@color/dt_accent" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/dt_surface_hi" />
                    <stroke android:width="1dp" android:color="@color/dt_stroke" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
