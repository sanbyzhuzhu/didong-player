<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/dt_glow">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/dt_pressed" />
                    <stroke android:width="1dp" android:color="@color/dt_accent" />
                    <corners android:radius="20dp" />
                    <padding android:left="12dp" android:top="5dp" android:right="12dp" android:bottom="5dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="@color/dt_stroke" />
                    <corners android:radius="20dp" />
                    <padding android:left="12dp" android:top="5dp" android:right="12dp" android:bottom="5dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
